APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Optional university-system APIs. Each API must return JSON in the documented
# format in README.md; tokens are sent as Bearer authorization headers.
# Read-only MySQL account used only for allow-listed CES campus tables.
# Separate reporting database credentials are used for aggregate snapshots.
CES_API_KEY=
CES_DB_HOST=127.0.0.1
CES_DB_PORT=3306
CES_DB_DATABASE=information_schema
CES_DB_USERNAME=
CES_DB_PASSWORD=
CES_REPORTING_DB_HOST=127.0.0.1
CES_REPORTING_DB_PORT=3306
CES_REPORTING_DB_DATABASE=qams_ces_reporting
CES_REPORTING_DB_USERNAME=
CES_REPORTING_DB_PASSWORD=
QAMS_CES_API_URL=
QAMS_CES_API_TOKEN=

QAMS_STUDENT_API_URL=
QAMS_STUDENT_API_TOKEN=
QAMS_LEARNING_API_URL=
QAMS_LEARNING_API_TOKEN=
QAMS_FINANCE_API_URL=
QAMS_FINANCE_API_TOKEN=
QAMS_HR_API_URL=
QAMS_HR_API_TOKEN=
QAMS_LIBRARY_API_URL=
QAMS_LIBRARY_API_TOKEN=
QAMS_RESEARCH_API_URL=
QAMS_RESEARCH_API_TOKEN=
QAMS_ONLINE_ADMISSION_API_URL=
QAMS_ONLINE_ADMISSION_API_TOKEN=
QAMS_PROCUREMENT_API_URL=
QAMS_PROCUREMENT_API_TOKEN=
QAMS_POLICY_API_URL=
QAMS_POLICY_API_TOKEN=
QAMS_CLINIC_API_URL=
QAMS_CLINIC_API_TOKEN=
QAMS_PAYSLIP_API_URL=
QAMS_PAYSLIP_API_TOKEN=
QAMS_FACULTY_EVALUATION_API_URL=
QAMS_FACULTY_EVALUATION_API_TOKEN=
QAMS_GENDER_AND_DEVELOPMENT_API_URL=
QAMS_GENDER_AND_DEVELOPMENT_API_TOKEN=
QAMS_PROXIMITY_ATTENDANCE_API_URL=
QAMS_PROXIMITY_ATTENDANCE_API_TOKEN=
QAMS_DESIGNATION_API_URL=
QAMS_DESIGNATION_API_TOKEN=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
