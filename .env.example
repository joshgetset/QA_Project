APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Optional university-system APIs. Each API must return JSON in the documented
# format in README.md; tokens are sent as Bearer authorization headers.
QAMS_STUDENT_API_URL=
QAMS_STUDENT_API_TOKEN=
QAMS_LEARNING_API_URL=
QAMS_LEARNING_API_TOKEN=
QAMS_FINANCE_API_URL=
QAMS_FINANCE_API_TOKEN=
QAMS_HR_API_URL=
QAMS_HR_API_TOKEN=
QAMS_LIBRARY_API_URL=
QAMS_LIBRARY_API_TOKEN=
QAMS_RESEARCH_API_URL=
QAMS_RESEARCH_API_TOKEN=
QAMS_SYSTEM_07_API_URL=
QAMS_SYSTEM_07_API_TOKEN=
QAMS_SYSTEM_08_API_URL=
QAMS_SYSTEM_08_API_TOKEN=
QAMS_SYSTEM_09_API_URL=
QAMS_SYSTEM_09_API_TOKEN=
QAMS_SYSTEM_10_API_URL=
QAMS_SYSTEM_10_API_TOKEN=
QAMS_SYSTEM_11_API_URL=
QAMS_SYSTEM_11_API_TOKEN=
QAMS_SYSTEM_12_API_URL=
QAMS_SYSTEM_12_API_TOKEN=
QAMS_SYSTEM_13_API_URL=
QAMS_SYSTEM_13_API_TOKEN=
QAMS_SYSTEM_14_API_URL=
QAMS_SYSTEM_14_API_TOKEN=
QAMS_SYSTEM_15_API_URL=
QAMS_SYSTEM_15_API_TOKEN=
QAMS_SYSTEM_17_API_URL=
QAMS_SYSTEM_17_API_TOKEN=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
